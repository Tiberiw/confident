    "rules:deploy": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tensorflow/tfjs": "^4.22.0",
    "date-fns": "^4.4.0",
