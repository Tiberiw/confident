    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
